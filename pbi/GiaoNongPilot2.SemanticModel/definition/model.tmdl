model GiaoNongPilot2
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_ProTooling = ["MCP-PBIModeling","DevMode"]

annotation PBI_QueryOrder = ["Fact_Orders","Dim_Date","Dim_Customer","Dim_Zone","Dim_TimeSlot","Dim_DistanceBand","DataFolder","SharedOrders"]

annotation __PBI_TimeIntelligenceEnabled = 1

ref table Fact_Orders
ref table Dim_Date
ref table Dim_Customer
ref table Dim_Zone
ref table Dim_TimeSlot
ref table Dim_DistanceBand
ref table Measure

ref cultureInfo en-US

